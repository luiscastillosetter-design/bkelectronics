                }`}
              >
                <Icon className={`w-4 h-4 transition-transform group-hover:scale-110 ${isSelected ? 'text-slate-900' : 'text-cyan-400'}`} />
                <span className="text-xs tracking-wider uppercase">{item.title}</span>
              </button>
            );
          })}
        </div>
      </div>
    </div>
  );
}
