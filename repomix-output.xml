              </div>

              {/* Totales */}
              <div className="bg-[#0B1120] rounded-2xl p-5 border border-slate-800 space-y-3 mb-8">
                <div className="flex items-center justify-between text-sm">
                  <span className="text-slate-400">Subtotal de Equipos</span>
                  <span className="font-bold text-slate-200">{siteConfig.currencySymbol}{total.toFixed(2)}</span>
                </div>
                <div className="flex items-center justify-between text-sm">
                  <span className="text-slate-400">Costo de Envío</span>
                  <span className={`font-bold ${envioGratis ? 'text-green-400' : 'text-slate-500'}`}>
                    {envioGratis ? 'GRATIS' : 'Cobro en Destino'}
                  </span>
                </div>
                <div className="pt-3 border-t border-slate-800 flex items-end justify-between">
                  <span className="text-lg font-bold text-white uppercase tracking-wider">Total Final</span>
                  <span className="text-3xl font-black text-yellow-400">
                    {siteConfig.currencySymbol}{total.toFixed(2)}
                  </span>
                </div>
              </div>

              {/* Botón de Acción */}
              <button
                onClick={handleConfirmarPedido}
                disabled={isSubmitting}
                className="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-900 py-5 rounded-2xl font-black text-lg uppercase tracking-widest transition-all shadow-[0_0_20px_rgba(6,182,212,0.3)] hover:-translate-y-1 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-3 cursor-pointer"
              >
                {isSubmitting ? 'Procesando...' : 'Facturar Vía WhatsApp'}
              </button>
              
            </div>
          </div>
          
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/app/product/[id]/page.tsx">
'use client';

import { useEffect, useState, Suspense, useRef } from 'react';
import { useParams, useRouter } from 'next/navigation';
import Link from 'next/link';
import { productService } from '@/services/productService';
import type { Product } from '@/data/products';
import { siteConfig } from '@/config/site';
import { useCartStore } from '@/store/cartStore'; // CONEXIÓN A TU CARRITO ORIGINAL ZUSTAND
import { 
  ChevronLeft, ChevronRight, ShoppingCart, MessageCircle, 
  Star, Truck, ShieldCheck, Zap, PackageOpen, PlayCircle, Check
} from 'lucide-react';

function ProductDetailContent() {
  const params = useParams();
  const router = useRouter();
  
  const { addItem, toggleCart } = useCartStore(); // FUNCIONES DE TU CARRITO
  
  const [product, setProduct] = useState<Product | null>(null);
  const [relatedProducts, setRelatedProducts] = useState<Product[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [activeImage, setActiveImage] = useState(0);
  
  const [quantity, setQuantity] = useState<number | string>(1);
  const [addedToCart, setAddedToCart] = useState(false);
  
  const relatedRef = useRef<HTMLDivElement>(null);
  const WHATSAPP_NUMBER = "12345678900"; // <--- NO OLVIDES CAMBIAR TU NÚMERO AQUÍ

  useEffect(() => {
    const fetchProductAndRelated = async () => {
      if (params.id) {
        setIsLoading(true);
        const currentProduct = await productService.getProductById(params.id as string);
        if (currentProduct) {
          setProduct(currentProduct);
          const related = await productService.getRelatedProducts(currentProduct.category, currentProduct.id);
          setRelatedProducts(related);
        }
        setIsLoading(false);
      }
    };
    fetchProductAndRelated();
  }, [params.id]);

  const scrollRelated = (direction: 'left' | 'right') => {
    if (relatedRef.current) {
      relatedRef.current.scrollBy({ left: direction === 'left' ? -300 : 300, behavior: 'smooth' });
    }
  };

  const handleQuantityChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    if (e.target.value === '') {
      setQuantity('');
      return;
    }
    const val = parseInt(e.target.value);
    if (!isNaN(val) && val > 0) {
      setQuantity(val);
    }
  };

  const handleQuantityBlur = () => {
    if (quantity === '' || Number(quantity) < 1) setQuantity(1);
  };

  const handleAddToCart = () => {
    if (product) {
      // Formateamos el producto para que encaje perfecto en tu Zustand original
      const cartItemFormat = {
        id: product.id,
        title: product.title,
        price: product.price,
        image: product.images[0]
      };

      addItem(cartItemFormat, Number(quantity));
      setAddedToCart(true);
      toggleCart(); // Abre el carrito lateral al instante
      
      setTimeout(() => setAddedToCart(false), 2000);
    }
  };

  if (isLoading) return <div className="min-h-screen bg-[#0B1120] flex items-center justify-center"><div className="w-12 h-12 border-4 border-cyan-500 border-t-transparent rounded-full animate-spin" /></div>;
  if (!product) return <div className="min-h-screen bg-[#0B1120] flex flex-col items-center justify-center"><PackageOpen className="w-20 h-20 text-slate-700 mb-6" /><h1 className="text-2xl font-bold text-white mb-2">No encontrado</h1></div>;

  const isOferta = product.badge === 'Oferta' || product.price > 100;
  const originalPrice = isOferta ? product.price * 1.25 : product.price; 
  const reviewCount = Math.floor(Math.random() * 400) + 15; 
  const isOutOfStock = (product.stock ?? 0) <= 0;

  const handleWhatsAppClick = () => {
    const text = `¡Hola BK Electronics! Me interesa el producto: *${product.title}* (Cód: ${product.id}). Precio: $${product.price.toFixed(2)}. Cantidad: ${quantity}.`;
    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`, '_blank');
  };

  const renderActiveMedia = () => {
    const currentMedia = product.images[activeImage] || product.images[0];
    const isVideo = currentMedia.includes('.mp4') || currentMedia.includes('.webm');
    
    if (isVideo) {
      return <video src={currentMedia} controls autoPlay muted loop className="absolute inset-0 w-full h-full object-cover" />;
    }
    return <img src={currentMedia} alt={product.title} className="absolute inset-0 w-full h-full object-cover" />;
  };

  return (
    <div className="min-h-screen bg-[#0B1120] pb-24 pt-[100px] md:pt-[140px] text-slate-200">
      <div className="w-full max-w-7xl mx-auto px-4 md:px-8">
        
        <button onClick={() => router.back()} className="group flex items-center gap-2 text-slate-400 hover:text-cyan-400 font-medium mb-8 transition-colors w-fit">
          <div className="p-2 bg-[#0F172A] rounded-full border border-slate-800 group-hover:border-cyan-500/50"><ChevronLeft className="w-5 h-5" /></div>
          Volver atrás
        </button>

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-10 xl:gap-16 mb-24">
          
          <div className="flex flex-col gap-4">
            <div className="relative w-full aspect-square bg-[#0F172A] rounded-3xl border border-slate-800 overflow-hidden shadow-[0_0_30px_rgba(6,182,212,0.05)]">
              {renderActiveMedia()}
              
              <div className="absolute top-4 left-4 flex flex-col gap-2 z-10">
                {product.badge && <span className={`px-3 py-1.5 text-xs font-bold uppercase tracking-wider rounded-lg shadow-lg ${product.badge === 'Agotado' ? 'bg-red-500 text-white' : 'bg-cyan-500 text-slate-900'}`}>{product.badge}</span>}
                {product.price >= 50 && <span className="px-3 py-1.5 text-xs font-bold uppercase tracking-wider rounded-lg shadow-lg bg-[#1E293B] text-yellow-400 border border-yellow-400/30">Envío Gratis</span>}
              </div>
            </div>

            {product.images.length > 1 && (
              <div className="flex gap-4 overflow-x-auto pb-2 scrollbar-hide">
                {product.images.map((media, idx) => {
                  const isVideo = media.includes('.mp4');
                  return (
                    <button key={idx} onClick={() => setActiveImage(idx)} className={`relative w-20 h-20 flex-shrink-0 rounded-xl overflow-hidden border-2 transition-all ${activeImage === idx ? 'border-cyan-500 shadow-[0_0_15px_rgba(6,182,212,0.4)]' : 'border-slate-800 opacity-60 hover:opacity-100'}`}>
                      {isVideo ? (
                        <div className="absolute inset-0 w-full h-full bg-slate-900 flex items-center justify-center">
                          <PlayCircle className="w-8 h-8 text-cyan-500" />
                        </div>
                      ) : (
                        <img src={media} alt={`Vista ${idx + 1}`} className="absolute inset-0 w-full h-full object-cover" />
                      )}
                    </button>
                  );
                })}
              </div>
            )}
          </div>

          <div className="flex flex-col pt-2 lg:pt-8">
            <div className="flex items-center justify-between mb-4">
              <span className="text-xs font-bold text-cyan-400 tracking-widest uppercase bg-cyan-900/30 px-3 py-1 rounded-full border border-cyan-500/20">{product.category}</span>
              <span className="text-sm font-medium text-slate-500">Cód: #{product.id}</span>
            </div>

            <h1 className="text-3xl md:text-4xl lg:text-5xl font-black text-white leading-[1.1] mb-4">{product.title}</h1>

            <div className="flex items-center gap-2 mb-8">
              <div className="flex text-yellow-400">{[1, 2, 3, 4, 5].map((star) => <Star key={star} className="w-5 h-5 fill-current" />)}</div>
              <span className="text-sm font-bold text-slate-300">4.9</span>
              <span className="text-sm text-slate-500">({reviewCount} valoraciones)</span>
            </div>

            <div className="mb-8">
              {isOferta && <p className="text-lg text-slate-500 line-through font-medium mb-1">{siteConfig.currencySymbol}{originalPrice.toFixed(2)}</p>}
              <div className="flex items-end gap-4">
                <p className="text-5xl font-black text-yellow-400 tracking-tight">{siteConfig.currencySymbol}{product.price.toFixed(2)}</p>
                {isOferta && <span className="bg-red-500/20 text-red-400 border border-red-500/30 px-2 py-1 rounded-md text-sm font-bold mb-2">-25%</span>}
              </div>
            </div>

            {!isOutOfStock && (
              <div className="flex flex-col sm:flex-row sm:items-center gap-4 mb-8 p-4 bg-[#0F172A]/80 border border-slate-800 rounded-2xl w-fit">
                <span className="text-sm font-bold text-slate-400 uppercase tracking-wider">Cantidad:</span>
                <div className="flex items-center bg-[#1E293B] border border-slate-700 rounded-xl overflow-hidden shadow-inner h-12">
                  <button onClick={() => setQuantity(Math.max(1, Number(quantity) - 1))} className="px-4 h-full text-cyan-400 hover:bg-slate-700 hover:text-cyan-300 transition-colors font-bold text-xl flex items-center justify-center">-</button>
                  <input 
                    type="number" 
                    min="1" 
                    value={quantity} 
                    onChange={handleQuantityChange} 
                    onBlur={handleQuantityBlur}
                    className="w-16 h-full text-center bg-transparent text-white font-black text-lg focus:outline-none appearance-none" 
                  />
                  <button onClick={() => setQuantity(Number(quantity) + 1)} className="px-4 h-full text-cyan-400 hover:bg-slate-700 hover:text-cyan-300 transition-colors font-bold text-xl flex items-center justify-center">+</button>
                </div>
              </div>
            )}

            <div className="mb-8 p-6 bg-[#0F172A]/50 border border-slate-800 rounded-2xl">
              <h3 className="text-sm font-bold text-white uppercase tracking-wider mb-3">Descripción</h3>
              <p className="text-slate-300 leading-relaxed text-sm md:text-base mb-6">{product.description}</p>
              <h3 className="text-sm font-bold text-white uppercase tracking-wider mb-3">Especificaciones</h3>
              <ul className="space-y-2">
                {product.features.map((feature, idx) => (
                  <li key={idx} className="flex items-start gap-2 text-sm text-slate-300">
                    <Zap className="w-4 h-4 text-cyan-400 mt-0.5 flex-shrink-0" />{feature}
                  </li>
                ))}
              </ul>
            </div>

            <div className="flex flex-col sm:flex-row gap-4 mt-auto">
              <button 
                onClick={handleAddToCart}
                className={`flex-1 flex items-center justify-center gap-3 py-4 md:py-5 rounded-2xl font-black text-sm md:text-base uppercase tracking-wider transition-all shadow-lg ${isOutOfStock ? 'bg-slate-800 text-slate-500 cursor-not-allowed' : addedToCart ? 'bg-green-500 text-slate-900 shadow-[0_0_30px_rgba(34,197,94,0.4)]' : 'bg-cyan-500 text-slate-900 hover:bg-cyan-400 hover:shadow-[0_0_30px_rgba(6,182,212,0.5)] hover:-translate-y-1'}`}
                disabled={isOutOfStock || addedToCart}
              >
                {addedToCart ? <Check className="w-6 h-6" /> : <ShoppingCart className="w-6 h-6" />}
                {isOutOfStock ? 'Sin Stock' : addedToCart ? 'Agregado' : 'Añadir al Carrito'}
              </button>
              
              <button onClick={handleWhatsAppClick} className="flex-1 flex items-center justify-center gap-3 bg-[#0F172A] border-2 border-[#25D366] text-[#25D366] hover:bg-[#25D366] hover:text-slate-900 py-4 md:py-5 rounded-2xl font-black text-sm md:text-base uppercase tracking-wider transition-all hover:shadow-[0_0_30px_rgba(37,211,102,0.3)] hover:-translate-y-1">
                <MessageCircle className="w-6 h-6" />
                Consulta rápida
              </button>
            </div>
          </div>
        </div>
        
        {relatedProducts.length > 0 && (
          <div className="w-full pt-12 border-t border-slate-800/80">
            <div className="flex items-center justify-between mb-8">
              <h2 className="text-2xl font-bold text-slate-100">Productos Similares</h2>
              <Link href={`/catalogo?category=${product.category}`} className="text-sm font-bold text-cyan-400 hover:text-cyan-300 flex items-center gap-1">
                Ver más <ChevronRight className="w-4 h-4" />
              </Link>
            </div>

            <div className="relative group">
              <button onClick={() => scrollRelated('left')} className="absolute -left-5 top-1/2 -translate-y-1/2 z-10 bg-[#0F172A] border border-cyan-500 shadow-[0_0_15px_rgba(6,182,212,0.3)] p-4 rounded-full text-cyan-400 hover:bg-cyan-500 hover:text-slate-900 transition-all opacity-0 group-hover:opacity-100 cursor-pointer hidden md:flex"><ChevronLeft className="w-6 h-6" /></button>
              <div ref={relatedRef} className="flex overflow-x-auto gap-5 snap-x pb-4 scrollbar-hide px-2 scroll-smooth">
                {relatedProducts.map((relProduct) => (
                  <Link key={relProduct.id} href={`/product/${relProduct.id}`} className="group flex-shrink-0 snap-start block">
                    <div className="bg-[#0F172A]/90 rounded-3xl shadow-lg border border-slate-700/80 transition-all duration-300 h-full flex flex-col w-[260px] hover:-translate-y-1 hover:border-cyan-500/60 hover:shadow-[0_0_20px_rgba(6,182,212,0.15)]">
                      <div className="relative w-full aspect-[4/5] bg-slate-900 overflow-hidden rounded-t-3xl">
                        <img src={relProduct.images[0]} alt={relProduct.title} className="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-80 group-hover:opacity-100" />
                        {relProduct.badge && <div className={`absolute top-3 left-3 text-[10px] font-bold px-2.5 py-1 rounded-md shadow-sm uppercase tracking-wider ${relProduct.badge === 'Agotado' ? 'bg-red-500/90 text-white' : 'bg-cyan-950/90 text-cyan-300 border border-cyan-500/50'}`}>{relProduct.badge}</div>}
                      </div>
                      <div className="flex flex-col flex-1 p-4">
                        <span className="text-[10px] font-bold text-cyan-400/80 uppercase tracking-wider mb-1 line-clamp-1">{relProduct.category}</span>
                        <h3 className="text-sm font-semibold text-slate-200 mb-2 line-clamp-2 group-hover:text-cyan-300 transition-colors">{relProduct.title}</h3>
                        <div className="flex items-center justify-between mt-auto pt-3 border-t border-slate-800/60">
                          <span className="text-lg font-black text-yellow-400">{siteConfig.currencySymbol}{relProduct.price.toFixed(2)}</span>
                          <span className="px-4 py-2 bg-[#1E293B] border border-slate-600 text-cyan-400 text-xs font-bold rounded-xl group-hover:bg-cyan-500 group-hover:text-slate-900 transition-colors">Ver</span>
                        </div>
                      </div>
                    </div>
                  </Link>
                ))}
              </div>
              <button onClick={() => scrollRelated('right')} className="absolute -right-5 top-1/2 -translate-y-1/2 z-10 bg-[#0F172A] border border-cyan-500 shadow-[0_0_15px_rgba(6,182,212,0.3)] p-4 rounded-full text-cyan-400 hover:bg-cyan-500 hover:text-slate-900 transition-all opacity-0 group-hover:opacity-100 cursor-pointer hidden md:flex"><ChevronRight className="w-6 h-6" /></button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

export default function ProductDetailPage() {
  return (
    <Suspense fallback={<div className="min-h-screen bg-[#0B1120] flex items-center justify-center"><div className="w-12 h-12 border-4 border-cyan-500 border-t-transparent rounded-full animate-spin" /></div>}>
      <ProductDetailContent />
    </Suspense>
  );
}
