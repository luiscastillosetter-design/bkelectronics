<file path="src/app/page.tsx">
'use client';

import { useEffect, useState, Suspense, useRef } from 'react';
import { useSearchParams } from 'next/navigation';
import Image from 'next/image';
import Link from 'next/link';
import { siteConfig } from '@/config/site';
import { productService } from '@/services/productService';
import type { Product } from '@/data/products';
import { ChevronLeft, ChevronRight } from 'lucide-react';
import { HeroCarousel } from '@/components/HeroCarousel';
import { OffersCarousel } from '@/components/OffersCarousel';
import { CategoryDock } from '@/components/CategoryDock';

const categoryDbNames = ['ENERGIA', 'HERRAMIENTAS', 'SONIDO', 'COMPUTACIONYCONECTIVIDAD', 'AUTOMOTRIZ'];

function HomeContent() {
  const searchParams = useSearchParams();
  const [products, setProducts] = useState<Product[]>([]);
  const [selectedCategory, setSelectedCategory] = useState<string>('Todos');
  const [filteredProducts, setFilteredProducts] = useState<Product[]>([]);

  const trendsRef = useRef<HTMLDivElement>(null);
  const catalogRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const loadProducts = async () => {
      if (typeof window !== 'undefined') {
        localStorage.removeItem('store_products');
      }
      const data = await productService.getProducts();
      setProducts(data);
      setFilteredProducts(data);
    };
    loadProducts();
  }, []);

  useEffect(() => {
    if (selectedCategory === 'Todos') {
      setFilteredProducts(products);
    } else {
      const filtered = products.filter(p => (p.category || '').toUpperCase().includes(selectedCategory));
      setFilteredProducts(filtered);
    }
  }, [selectedCategory, products]);

  useEffect(() => {
    const ref = searchParams.get('ref');
    if (ref) localStorage.setItem('todomax_ref', ref);
  }, [searchParams]);

  const getProductsByCategory = (dbCategoryName: string) => {
    return products.filter(p => (p.category || '').toUpperCase().includes(dbCategoryName)).slice(0, 3);
  };

  const getCatalogProducts = () => {
    return products.slice(0, 18);
  };

  const scrollLeft = (ref: React.RefObject<HTMLDivElement | null>) => {
    if (ref.current) ref.current.scrollBy({ left: -400, behavior: 'smooth' });
  };

  const scrollRight = (ref: React.RefObject<HTMLDivElement | null>) => {
    if (ref.current) ref.current.scrollBy({ left: 400, behavior: 'smooth' });
  };

  return (
    <div className="min-h-screen bg-[#0B1120] pb-20 w-full overflow-x-hidden">
      
      {/* SECCIÓN HERO A ANCHO TOTAL */}
      <section className="w-full relative pt-[60px] md:pt-[80px] mb-16 md:mb-24">
        <HeroCarousel />
        <div className="absolute -bottom-8 md:-bottom-10 left-0 right-0 z-50 px-4 md:px-12">
           <CategoryDock onSelect={(id) => setSelectedCategory(id)} />
        </div>
      </section>

      {/* CONTENIDO PRINCIPAL A ANCHO TOTAL DE LA PANTALLA */}
      <div className="w-full px-4 md:px-10 xl:px-16">
        
        {/* ÚLTIMAS TENDENCIAS */}
        <main className="w-full mb-16 md:mb-24">
          <div className="flex items-center justify-between mb-6">
            <h2 className="text-xl md:text-2xl font-bold text-slate-100">
              {selectedCategory === 'Todos' ? 'Últimas Tendencias' : `Novedades en ${selectedCategory}`}
            </h2>
            <Link href={`/catalogo${selectedCategory !== 'Todos' ? `?category=${selectedCategory}` : ''}`} className="text-xs md:text-sm font-bold text-cyan-400 hover:text-cyan-300 flex items-center gap-1">
              Ver todo <ChevronRight className="w-4 h-4" />
            </Link>
          </div>

          {products.length === 0 ? (
            <div className="flex flex-col items-center justify-center py-20 bg-[#0F172A]/50 border border-slate-800 rounded-2xl w-full">
              <div className="w-8 h-8 border-4 border-cyan-500 border-t-transparent rounded-full animate-spin mb-4" />
              <p className="text-sm md:text-base text-slate-400 font-medium">Cargando inventario premium...</p>
            </div>
          ) : (
            <div className="relative group w-full">
              <button onClick={() => scrollLeft(trendsRef)} className="absolute -left-3 md:-left-5 top-1/2 -translate-y-1/2 z-10 bg-[#0F172A] border border-cyan-500 shadow-[0_0_15px_rgba(6,182,212,0.3)] p-3 md:p-4 rounded-full text-cyan-400 hover:bg-cyan-500 hover:text-slate-900 transition-all opacity-0 group-hover:opacity-100 cursor-pointer hidden md:flex">
                <ChevronLeft className="w-5 h-5 md:w-6 md:h-6" />
              </button>

              <div ref={trendsRef} className="flex overflow-x-auto gap-4 md:gap-5 snap-x pb-6 scrollbar-hide px-2 scroll-smooth w-full">
                {(selectedCategory === 'Todos' ? categoryDbNames : [selectedCategory]).map((cat) => {
                  const catProducts = getProductsByCategory(cat);
                  return catProducts.map((product) => (
                    <Link key={product.id} href={`/product/${product.id}`} className="group flex-shrink-0 snap-start block">
                      <div className="bg-[#0F172A]/90 rounded-2xl md:rounded-3xl shadow-lg border border-slate-700/80 transition-all duration-300 h-full flex flex-col w-[180px] md:w-[260px] hover:-translate-y-1 hover:border-cyan-500/60 hover:shadow-[0_0_20px_rgba(6,182,212,0.15)]">
                        <div className="relative w-full aspect-[4/5] bg-[#070b14] overflow-hidden rounded-t-2xl md:rounded-t-3xl flex items-center justify-center">
                          <img src={product.images[0]} alt={product.title} className="w-full h-full object-contain p-6 group-hover:scale-105 transition-transform duration-700 ease-out opacity-80 group-hover:opacity-100" />
                          {product.badge && (
                            <div className={`absolute top-2.5 left-2.5 text-[9px] md:text-[10px] font-bold px-2 py-1 md:px-2.5 rounded-md shadow-sm uppercase tracking-wider ${product.badge === 'Agotado' ? 'bg-red-500/90 text-white' : 'bg-cyan-950/90 text-cyan-300 border border-cyan-500/50'}`}>
                              {product.badge}
                            </div>
                          )}
                        </div>
                        <div className="flex flex-col flex-1 p-3 md:p-4">
                          <span className="text-[9px] md:text-[10px] font-bold text-cyan-400/80 uppercase tracking-wider mb-1 line-clamp-1">{product.category}</span>
                          <h3 className="text-xs md:text-sm font-semibold text-slate-200 mb-2 line-clamp-2 group-hover:text-cyan-300 transition-colors">
                            {product.title}
                          </h3>
                          <div className="flex items-center justify-between mt-auto pt-3 border-t border-slate-800/60">
                            <span className="text-sm md:text-lg font-black text-yellow-400">{siteConfig.currencySymbol}{product.price.toFixed(2)}</span>
                            <span className="px-2 py-1 md:px-4 md:py-2 bg-[#1E293B] border border-slate-600 text-cyan-400 text-[10px] md:text-xs font-bold rounded-lg md:rounded-xl group-hover:bg-cyan-500 group-hover:text-slate-900 transition-colors">
                              Ver
                            </span>
                          </div>
                        </div>
                      </div>
                    </Link>
                  ));
                })}
              </div>

              <button onClick={() => scrollRight(trendsRef)} className="absolute -right-3 md:-right-5 top-1/2 -translate-y-1/2 z-10 bg-[#0F172A] border border-cyan-500 shadow-[0_0_15px_rgba(6,182,212,0.3)] p-3 md:p-4 rounded-full text-cyan-400 hover:bg-cyan-500 hover:text-slate-900 transition-all opacity-0 group-hover:opacity-100 cursor-pointer hidden md:flex">
                <ChevronRight className="w-5 h-5 md:w-6 md:h-6" />
              </button>
            </div>
          )}
        </main>

        {/* OFERTAS CAROUSEL */}
        <section className="w-full mb-16 md:mb-24">
          <OffersCarousel />
        </section>

        {/* CATÁLOGO GENERAL CAROUSEL */}
        <section className="w-full">
          <div className="flex items-center justify-between mb-6">
            <h2 className="text-xl md:text-2xl font-bold text-slate-100">Catálogo General</h2>
            <Link href="/catalogo" className="text-xs md:text-sm font-bold text-cyan-400 hover:text-cyan-300 flex items-center gap-1">
              Ver catálogo completo <ChevronRight className="w-4 h-4" />
            </Link>
          </div>

          <div className="relative group w-full">
            <button onClick={() => scrollLeft(catalogRef)} className="absolute -left-3 md:-left-5 top-1/2 -translate-y-1/2 z-10 bg-[#0F172A] border border-cyan-500 shadow-[0_0_15px_rgba(6,182,212,0.3)] p-3 md:p-4 rounded-full text-cyan-400 hover:bg-cyan-500 hover:text-slate-900 transition-all opacity-0 group-hover:opacity-100 cursor-pointer hidden md:flex">
              <ChevronLeft className="w-5 h-5 md:w-6 md:h-6" />
            </button>

            <div ref={catalogRef} className="flex overflow-x-auto gap-4 md:gap-5 snap-x pb-6 scrollbar-hide px-2 scroll-smooth w-full">
              {getCatalogProducts().map((product) => (
                <Link key={product.id} href={`/product/${product.id}`} className="group flex-shrink-0 snap-start block">
                  <div className="bg-[#0F172A]/90 rounded-2xl md:rounded-3xl shadow-lg border border-slate-700/80 transition-all duration-300 h-full flex flex-col w-[180px] md:w-[260px] hover:-translate-y-1 hover:border-cyan-500/60 hover:shadow-[0_0_20px_rgba(6,182,212,0.15)]">
                    <div className="relative w-full aspect-[4/5] bg-[#070b14] overflow-hidden rounded-t-2xl md:rounded-t-3xl flex items-center justify-center">
                      <img src={product.images[0]} alt={product.title} className="w-full h-full object-contain p-6 group-hover:scale-105 transition-transform duration-700 ease-out opacity-80 group-hover:opacity-100" />
                      {product.badge && (
                        <div className={`absolute top-2.5 left-2.5 text-[9px] md:text-[10px] font-bold px-2 py-1 md:px-2.5 rounded-md shadow-sm uppercase tracking-wider ${product.badge === 'Agotado' ? 'bg-red-500/90 text-white' : 'bg-cyan-950/90 text-cyan-300 border border-cyan-500/50'}`}>
                          {product.badge}
                        </div>
                      )}
                    </div>
                    <div className="flex flex-col flex-1 p-3 md:p-4">
