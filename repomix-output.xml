                    </div>
                  </div>
                </Link>
              ))}
            </div>

            <button onClick={() => scrollRight(catalogRef)} className="absolute -right-3 md:-right-5 top-1/2 -translate-y-1/2 z-10 bg-[#0F172A] border border-cyan-500 shadow-[0_0_15px_rgba(6,182,212,0.3)] p-3 md:p-4 rounded-full text-cyan-400 hover:bg-cyan-500 hover:text-slate-900 transition-all opacity-0 group-hover:opacity-100 cursor-pointer hidden md:flex">
              <ChevronRight className="w-5 h-5 md:w-6 md:h-6" />
            </button>
          </div>
        </section>

      </div>
    </div>
  );
}

