      (refCode !== 'DIRECTO' ? `\n\n🎟️ *CÓDIGO AFILIADO:* ${refCode}` : '');

    const rawWhatsApp = siteConfig.whatsapp?.number || siteConfig.whatsappNumber || '';
    const whatsappNum = String(rawWhatsApp).replace(/\D/g, '');

    // BLINDAJE: Codificamos TODO el bloque de texto para que WhatsApp no rompa el link
    const mensajeCodificado = encodeURIComponent(mensaje);

    // Limpiamos el carrito después de enviar
    setTimeout(() => {
      clearCart();
      setIsSubmitting(false);
      // Redirigimos al inicio luego de comprar
      router.push('/');
