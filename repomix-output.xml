const getCategoryIcon = (category: string) => {
  const cat = (category || '').toUpperCase();
  const testVideo = 'https://www.w3schools.com/html/mov_bbb.mp4';
  let iconUrl = ICONS.default;

  if (cat.includes('ENERGIA') || cat.includes('SOLAR')) iconUrl = ICONS.energia;
  else if (cat.includes('HERRAMIENTA')) iconUrl = ICONS.herramientas;
  else if (cat.includes('FERRETERIA')) iconUrl = ICONS.ferreteria;
  else if (cat.includes('SONIDO') || cat.includes('AUDIO')) iconUrl = ICONS.sonido;
  else if (cat.includes('COMPUTACION') || cat.includes('REDES') || cat.includes('CONECTIVIDAD')) iconUrl = ICONS.computacion;
  else if (cat.includes('AUTOMOTRIZ')) iconUrl = ICONS.automotriz;
  else if (cat.includes('HOGAR') || cat.includes('OFICINA')) iconUrl = ICONS.hogar;
  else if (cat.includes('SERVICIO') || cat.includes('TECNICO')) iconUrl = ICONS.servicio;
  else if (cat.includes('CREADOR') || cat.includes('CONTENIDO')) iconUrl = ICONS.creador;

  return [iconUrl, iconUrl, testVideo];
};

const formatProduct = (item: any): Product => {
  const stockQty = Number(item.stock ?? 0);
  return {
    id: String(item.id),
    title: String(item.title || ''),
    price: Number(item.price) || 0,
    category: String(item.category || 'General'),
    stock: stockQty,
    badge: stockQty <= 0 ? 'Agotado' : (Number(item.price) >= 50 ? 'Envío Gratis' : 'Oferta'),
    images: getCategoryIcon(item.category),
    description: `${item.title}. Equipo con garantía oficial de BK Electronics. Ideal para integraciones profesionales.`,
    features: ['Garantía directa de tienda', 'Envíos a nivel nacional', 'Zelle, Pago Móvil, Efectivo y Binance'],
    paymentMethods: ['Pago Móvil', 'Zelle', 'Efectivo', 'Binance Pay'],
  };
};

export const productService = {
  async getProducts(): Promise<Product[]> {
    try {
      const { data, error } = await supabase.from('products').select('*').order('id', { ascending: true });
      if (error || !data) return [];
      return data.map(formatProduct);
    } catch (err) {
      console.error("Error cargando productos:", err);
      return [];
    }
  },

  async getProductById(id: string): Promise<Product | undefined> {
    try {
      const { data, error } = await supabase.from('products').select('*').eq('id', id).maybeSingle();
      if (error || !data) return undefined;
      return formatProduct(data);
    } catch (err) {
      console.error(`Error cargando producto ${id}:`, err);
      return undefined;
    }
  },

  async getRelatedProducts(category: string, currentProductId: string): Promise<Product[]> {
    try {
      const { data, error } = await supabase
        .from('products')
        .select('*')
        .eq('category', category)
        .neq('id', currentProductId)
        .limit(10);
        
      if (error || !data) return [];
      return data.map(formatProduct);
    } catch (err) {
      console.error("Error cargando productos relacionados:", err);
      return [];
    }
  }
};
